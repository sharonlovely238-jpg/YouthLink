@app.get(
    "/petitions/{petition_id}/status",
    response_model=schemas.PetitionStatusResponse,
)
def get_petition_status(
    petition_id: int,
    username: str | None = None,
    db: Session = Depends(get_db),
):
    if db.get(models.Petition, petition_id) is None:
        raise HTTPException(status_code=404, detail="Petition not found.")

    thumbs_up = db.scalar(
        select(func.count(models.PetitionVote.id)).where(
            models.PetitionVote.petition_id == petition_id,
            models.PetitionVote.value == 1,
        )
    ) or 0
    thumbs_down = db.scalar(
        select(func.count(models.PetitionVote.id)).where(
            models.PetitionVote.petition_id == petition_id,
            models.PetitionVote.value == -1,
        )
    ) or 0
    signature_count = db.scalar(
        select(func.count(models.PetitionSignature.id)).where(
            models.PetitionSignature.petition_id == petition_id
        )
    ) or 0

    user_vote = None
    user_signed = False
    if username:
        clean_username = username.strip()
        vote = db.scalar(
            select(models.PetitionVote).where(
                models.PetitionVote.petition_id == petition_id,
                models.PetitionVote.username == clean_username,
            )
        )
        user_vote = vote.value if vote else None
        user_signed = db.scalar(
            select(models.PetitionSignature.id).where(
                models.PetitionSignature.petition_id == petition_id,
                models.PetitionSignature.username == clean_username,
            )
        ) is not None

    return {
        "petition_id": petition_id,
        "thumbs_up": thumbs_up,
        "thumbs_down": thumbs_down,
        "signature_count": signature_count,
        "user_vote": user_vote,
        "user_signed": user_signed,
    }


@app.put("/petitions/{petition_id}/vote")
def vote_on_petition(
    petition_id: int,
    vote_data: schemas.PetitionVoteCreate,
    db: Session = Depends(get_db),
):
    if db.get(models.Petition, petition_id) is None:
        raise HTTPException(status_code=404, detail="Petition not found.")

    if vote_data.value not in (-1, 1):
        raise HTTPException(status_code=422, detail="Vote must be 1 or -1.")

    username = vote_data.username.strip()
    vote = db.scalar(
        select(models.PetitionVote).where(
            models.PetitionVote.petition_id == petition_id,
            models.PetitionVote.username == username,
        )
    )

    if vote is None:
        vote = models.PetitionVote(
            petition_id=petition_id,
            username=username,
            value=vote_data.value,
        )
        db.add(vote)
    elif vote.value == vote_data.value:
        # Pressing the same reaction again removes it.
        db.delete(vote)
    else:
        # Switching from up to down (or down to up) updates the same row.
        vote.value = vote_data.value

    db.commit()
    return {"message": "Petition feedback updated."}


@app.post("/petitions/{petition_id}/signatures", status_code=201)
def sign_petition(
    petition_id: int,
    signature_data: schemas.PetitionSignatureCreate,
    db: Session = Depends(get_db),
):
    if db.get(models.Petition, petition_id) is None:
        raise HTTPException(status_code=404, detail="Petition not found.")

    username = signature_data.username.strip()
    existing = db.scalar(
        select(models.PetitionSignature).where(
            models.PetitionSignature.petition_id == petition_id,
            models.PetitionSignature.username == username,
        )
    )
    if existing is not None:
        raise HTTPException(status_code=409, detail="You already signed this petition.")

    signature = models.PetitionSignature(
        petition_id=petition_id,
        username=username,
    )
    db.add(signature)
    db.commit()
    return {"message": "Petition signed."}


@app.delete("/petitions/{petition_id}/signatures/{username}")
def withdraw_petition_signature(
    petition_id: int,
    username: str,
    db: Session = Depends(get_db),
):
    signature = db.scalar(
        select(models.PetitionSignature).where(
            models.PetitionSignature.petition_id == petition_id,
            models.PetitionSignature.username == username.strip(),
        )
    )
    if signature is None:
        raise HTTPException(status_code=404, detail="You have not signed this petition.")

    db.delete(signature)
    db.commit()
    return {"message": "Signature withdrawn."}


